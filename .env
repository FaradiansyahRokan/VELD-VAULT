# ============================================================
# VELD-VAULT (CipherVault) — Docker Environment Configuration
# ============================================================

# ── 1. PORT MAPPING VPS ─────────────────────────────────────
# Port 3000 sudah dipakai di VPS ini (sales-setter-frontend).
# Default VELD-VAULT diarahkan ke 3005.
PORT=3005

# Port 8080 sudah dipakai di VPS ini (evolution-api).
# IPFS Gateway dialihkan ke 8088.
IPFS_GATEWAY_PORT=8088

# Port IPFS API & Swarm (default)
IPFS_API_PORT=5001
IPFS_SWARM_PORT=4001

# Port Hardhat Local Node (jika pakai profile local-chain)
HARDHAT_RPC_PORT=8545


# ── 2. BLOCKCHAIN / RPC CONFIG ──────────────────────────────
# RPC BridgeStone L1 Avalanche yang berjalan di VPS (via rpc-proxy port 9656)
NEXT_PUBLIC_RPC_URL=http://212.47.73.139:9656/ext/bc/2WTeq6wMqLTuzvHXtJYXKwrwwRqE7vzLST6FtKsKohudhReysh/rpc

# Chain ID & Network Name
NEXT_PUBLIC_CHAIN_ID=666999
NEXT_PUBLIC_NETWORK_NAME=bridgestone
NEXT_PUBLIC_TOKEN_SYMBOL=VELD
NEXT_PUBLIC_TOKEN_NAME=VELD Token
NEXT_PUBLIC_EXPLORER_URL=

# Alamat Smart Contract CipherVault hasil deploy baru
NEXT_PUBLIC_CONTRACT_ADDRESS=0xF06CB869b3f5EF3F997b747D9C119971664141aF


# ── 3. IPFS CONFIG ──────────────────────────────────────────
# Dari dalam container Next.js, kubo dipanggil via service name 'ipfs'
NEXT_PUBLIC_IPFS_URL=http://127.0.0.1:5001
# Gateway untuk preview di browser (IP VPS: 212.47.73.139)
NEXT_PUBLIC_IPFS_GATEWAY=http://212.47.73.139:8088


# ── 4. FAUCET & DEPLOYER (OPSIONAL) ─────────────────────────
# Private key akun teleporter-deployer yang memiliki saldo VELD untuk mengisi faucet
FAUCET_PRIVATE_KEY=a5989cdaa721e2ba02377254f28d911fcdbfca7233dfa8b84943e37978301ee1
FAUCET_AMOUNT=1
FAUCET_COOLDOWN_MS=86400000
STC_DEPLOYER_PRIVATE_KEY=a5989cdaa721e2ba02377254f28d911fcdbfca7233dfa8b84943e37978301ee1


# ── 5. VERCEL KV / UPSTASH REDIS (OPSIONAL) ─────────────────
# Diperlukan untuk E2E encrypted messages relay & pubkey store jika menggunakan fitur chat
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret untuk update tunnel via API (opsional)
TUNNEL_UPDATE_SECRET=
